TRADING_SCANNER_SCAN_INTERVAL_HOURS=24
TRADING_SCANNER_CANDLE_INTERVAL=week
TRADING_SCANNER_CANDLE_HISTORY=300
TRADING_SCANNER_SYMBOLS_FILE=config/nifty_smallcap250_symbols.txt
TRADING_SCANNER_LOGGING_LEVEL=INFO

# This fork is weekly-signal-only (Nifty Smallcap 250 universe) -- see
# infrastructure/weekly_resample.py. "week" is not a real Kite interval;
# WeeklyResamplingProvider bridges it from real day-interval Kite data.
# Run trading_scanner.signals (the cron/download pipeline) once a day, well
# after market close -- there is no WebSocket live_pipeline.py in this
# fork's deployment; weekly signals only need a daily check, not
# continuous intraday connection. See deploy/ for the systemd timer.

# Required by the signal pipeline (trading_scanner.signals).
# Use "file:local.db" for local dev with no Turso account, or
# "file:data/skytrade-smallcap.db" to match this fork's production layout.
TRADING_SCANNER_TURSO_URL=
TRADING_SCANNER_TURSO_AUTH_TOKEN=

# Same Zerodha/Kite account as the parent p-trade project -- historical
# data access isn't symbol-universe-limited, so no separate app registration
# is needed just to add the smallcap-250 names.
TRADING_SCANNER_KITE_API_KEY=
TRADING_SCANNER_KITE_API_SECRET=

# Optional: falls back to console logging when unset.
TRADING_SCANNER_TELEGRAM_BOT_TOKEN=
TRADING_SCANNER_TELEGRAM_CHAT_ID=

# Shown in every Telegram message header -- this fork shares the parent
# p-trade's exact bot/chat ID, so without a distinct label there'd be no
# way to tell a Smallcap message from a Nifty50 one (2026-08-17 fix).
TRADING_SCANNER_NOTIFICATION_LABEL=Smallcap

# Optional: broad market index evaluated alongside every stock signal, for
# noise context only (never used to suppress a signal). Defaults to NIFTY 50.
# Set to empty to disable index tracking entirely.
TRADING_SCANNER_INDEX_SYMBOL=^NSEI

# Paper account sizing -- separate pool from the parent project's live cash
# account. 10 slots x Rs 50k each = Rs 5L total capital (2026-08-16 sizing
# decision).
TRADING_SCANNER_PAPER_CAPITAL=500000
TRADING_SCANNER_PAPER_SLOTS=10
TRADING_SCANNER_PAPER_MIN_POSITION=50000

# No stop-loss in this fork by design (2026-08-14 decision): weekly trades
# average -6.25% on losers with normal week-to-week swings well past any
# tick-level threshold that would make sense -- positions exit on the
# engine's own signal only, same as the original Lorentzian design intends.
# TRADING_SCANNER_STOP_LOSS_PCT / TRAILING_STOP_* are read only by
# live_pipeline.py (the WebSocket service), which this fork does not run,
# so they have no effect here even if set.

# Ranking score floor -- left at 0 (no floor) by default. The parent
# project found its Stage A score formula, once fixed, doesn't reliably
# separate good from bad candidates on its own (2026-08-14 "CRITICAL
# CORRECTION" finding) -- relative ranking as a tie-breaker is still used,
# just no absolute rejection floor until there's real evidence for one.
TRADING_SCANNER_RANKING_MIN_SCORE=0

TRADING_SCANNER_DASHBOARD_PASSWORD=
